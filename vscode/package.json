{
  "name": "agora",
  "displayName": "Agora",
  "description": "讓 Claude Code、Antigravity、Codex 在同一個專案裡討論與分工：選擇參與的 AI 與模型、管理討論串、查看額度。",
  "version": "0.2.0",
  "publisher": "richard-jheng",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:.agora",
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agora",
          "title": "Agora",
          "icon": "media/agora.svg"
        }
      ]
    },
    "views": {
      "agora": [
        {
          "type": "webview",
          "id": "agora.parties",
          "name": "AI 與模型"
        },
        {
          "id": "agora.threads",
          "name": "討論串"
        }
      ]
    },
    "commands": [
      {
        "command": "agora.install",
        "title": "安裝到此專案",
        "category": "Agora"
      },
      {
        "command": "agora.newThread",
        "title": "新增討論串",
        "category": "Agora",
        "icon": "$(add)"
      },
      {
        "command": "agora.refresh",
        "title": "重新整理",
        "category": "Agora",
        "icon": "$(refresh)"
      },
      {
        "command": "agora.openTranscript",
        "title": "開啟逐字稿",
        "category": "Agora",
        "icon": "$(open-preview)"
      },
      {
        "command": "agora.openLive",
        "title": "開啟即時回覆",
        "category": "Agora",
        "icon": "$(pulse)"
      },
      {
        "command": "agora.send",
        "title": "發言",
        "category": "Agora",
        "icon": "$(comment)"
      },
      {
        "command": "agora.auto",
        "title": "讓 AI 自動討論",
        "category": "Agora",
        "icon": "$(debug-continue)"
      },
      {
        "command": "agora.summarize",
        "title": "產出討論總結",
        "category": "Agora",
        "icon": "$(checklist)"
      },
      {
        "command": "agora.assign",
        "title": "分派工作",
        "category": "Agora",
        "icon": "$(run)"
      },
      {
        "command": "agora.status",
        "title": "查看分派進度",
        "category": "Agora"
      },
      {
        "command": "agora.changes",
        "title": "檢視分派期間的變更",
        "category": "Agora",
        "icon": "$(diff)"
      },
      {
        "command": "agora.recall",
        "title": "收回分派的工作",
        "category": "Agora"
      },
      {
        "command": "agora.quota",
        "title": "查看三方額度",
        "category": "Agora"
      },
      {
        "command": "agora.check",
        "title": "執行工作區驗證",
        "category": "Agora"
      },
      {
        "command": "agora.prune",
        "title": "清理不再需要的討論串",
        "category": "Agora",
        "icon": "$(trash)"
      },
      {
        "command": "agora.deleteThread",
        "title": "刪除此討論串",
        "category": "Agora"
      },
      {
        "command": "agora.keep",
        "title": "標記保留（不會被清理）",
        "category": "Agora"
      },
      {
        "command": "agora.unkeep",
        "title": "取消保留",
        "category": "Agora"
      },
      {
        "command": "agora.stopJob",
        "title": "停止討論",
        "category": "Agora",
        "icon": "$(debug-stop)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agora.newThread",
          "when": "view == agora.threads",
          "group": "navigation@1"
        },
        {
          "command": "agora.refresh",
          "when": "view == agora.threads",
          "group": "navigation@2"
        },
        {
          "command": "agora.prune",
          "when": "view == agora.threads",
          "group": "9_cleanup"
        }
      ],
      "view/item/context": [
        {
          "command": "agora.send",
          "when": "view == agora.threads && viewItem =~ /^thread/",
          "group": "inline@1"
        },
        {
          "command": "agora.openTranscript",
          "when": "view == agora.threads && viewItem =~ /^thread/",
          "group": "inline@2"
        },
        {
          "command": "agora.send",
          "when": "view == agora.threads && viewItem =~ /^thread/",
          "group": "1_talk@1"
        },
        {
          "command": "agora.auto",
          "when": "view == agora.threads && viewItem =~ /^thread/",
          "group": "1_talk@2"
        },
        {
          "command": "agora.summarize",
          "when": "view == agora.threads && viewItem =~ /^thread/",
          "group": "1_talk@4"
        },
        {
          "command": "agora.assign",
          "when": "view == agora.threads && viewItem =~ /^thread/",
          "group": "2_work@1"
        },
        {
          "command": "agora.status",
          "when": "view == agora.threads && viewItem =~ /relay/",
          "group": "2_work@2"
        },
        {
          "command": "agora.recall",
          "when": "view == agora.threads && viewItem =~ /relay-active/",
          "group": "2_work@3"
        },
        {
          "command": "agora.changes",
          "when": "view == agora.threads && viewItem =~ /relay/",
          "group": "2_work@4"
        },
        {
          "command": "agora.keep",
          "when": "view == agora.threads && viewItem =~ /^thread(?!.*kept)/",
          "group": "9_cleanup@1"
        },
        {
          "command": "agora.unkeep",
          "when": "view == agora.threads && viewItem =~ /kept$/",
          "group": "9_cleanup@1"
        },
        {
          "command": "agora.deleteThread",
          "when": "view == agora.threads && viewItem =~ /^thread/",
          "group": "9_cleanup@2"
        },
        {
          "command": "agora.stopJob",
          "when": "view == agora.threads && viewItem =~ /-job/",
          "group": "inline@0"
        },
        {
          "command": "agora.stopJob",
          "when": "view == agora.threads && viewItem =~ /-job/",
          "group": "1_talk@3"
        },
        {
          "command": "agora.openLive",
          "when": "view == agora.threads && viewItem =~ /-job|relay-active/",
          "group": "inline@0"
        },
        {
          "command": "agora.openLive",
          "when": "view == agora.threads && viewItem =~ /-job|relay-active/",
          "group": "1_talk@0"
        }
      ],
      "commandPalette": [
        {
          "command": "agora.openTranscript",
          "when": "false"
        },
        {
          "command": "agora.status",
          "when": "false"
        },
        {
          "command": "agora.recall",
          "when": "false"
        },
        {
          "command": "agora.deleteThread",
          "when": "false"
        },
        {
          "command": "agora.keep",
          "when": "false"
        },
        {
          "command": "agora.unkeep",
          "when": "false"
        },
        {
          "command": "agora.stopJob",
          "when": "false"
        },
        {
          "command": "agora.openLive",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Agora",
      "properties": {
        "agora.root": {
          "type": "string",
          "default": "",
          "markdownDescription": "Agora 程式所在的資料夾（含 `agora.py`）。留空時使用打包擴充套件時記錄的路徑。"
        },
        "agora.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "執行 agora.py 的 Python。"
        },
        "agora.quotaRefreshMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "description": "狀態列額度的更新間隔（分鐘），0 表示不自動更新。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node scripts/stamp-root.js",
    "package": "npx --yes @vscode/vsce package --allow-missing-repository --skip-license",
    "test": "node --test \"test/*.test.js\""
  }
}
